{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fixmeapp-vn/demo-fixme-premium-laravel-backend",
    "type": "project",
    "description": "FixMe Premium backend: Laravel modular monolith (HTTP API + queue worker).",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "ext-pcntl": "Required for graceful SIGTERM/SIGINT handling in the queue worker.",
        "ext-redis": "Recommended METRICS_STORE / cache backend outside development."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "fmt": "pint",
        "fmt:check": "pint --test",
        "lint": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:parallel": [
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
