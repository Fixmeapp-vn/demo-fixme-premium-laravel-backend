# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="FixMe Premium"
# development | test | staging | production
# (mapped to Laravel's "local" / "testing" / "staging" / "production")
APP_ENV=development
# Required in staging/production. Generate with: php artisan key:generate
APP_KEY=
# Never true outside development: debug output is not sent to clients anyway,
# but Laravel enables extra diagnostics when it is on.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Service name attached to every log record (lowercase, digits, . _ -).
SERVICE_NAME=fixme-premium-backend

# -----------------------------------------------------------------------------
# HTTP server (seconds)
# -----------------------------------------------------------------------------
# Listen address for `make run-api` (php artisan platform:serve).
HTTP_ADDR=127.0.0.1:8000
# Max execution time per request (1-300). Enforced in PHP (CPU time) and as FPM's
# wall-clock request_terminate_timeout; nginx fastcgi_read_timeout should be ~5s higher.
HTTP_REQUEST_TIMEOUT=30
# Web-server header read timeout (1-120): nginx client_header_timeout.
HTTP_READ_HEADER_TIMEOUT=10
# Web-server keep-alive idle timeout (1-900): nginx keepalive_timeout.
HTTP_IDLE_TIMEOUT=60

# -----------------------------------------------------------------------------
# Queue worker and graceful shutdown (seconds)
# -----------------------------------------------------------------------------
# Max runtime of a single queued job (queue:work --timeout), 1-299.
QUEUE_JOB_TIMEOUT=25
# Grace period a process manager waits after SIGTERM before killing (supervisor
# stopwaitsecs, FPM process_control_timeout, nginx worker_shutdown_timeout), 1-300.
# Must be greater than QUEUE_JOB_TIMEOUT.
SHUTDOWN_TIMEOUT=30

# -----------------------------------------------------------------------------
# Metrics
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
# Internal listener for GET /metrics (must differ from HTTP_ADDR's port).
METRICS_ADDR=127.0.0.1:9100
# Cache store holding samples between requests: file (local) | redis (recommended elsewhere).
METRICS_STORE=file
# Namespace for this instance's samples in a shared store (empty = hostname).
# METRICS_INSTANCE=

# -----------------------------------------------------------------------------
# Logging (JSON lines on stderr)
# -----------------------------------------------------------------------------
LOG_CHANNEL=json
# debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=debug
# LOG_STREAM=php://stderr

# -----------------------------------------------------------------------------
# Queue / cache (no database or Redis needed for this foundation)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Database settings arrive with BE-002 (PostgreSQL).
